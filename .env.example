# Token que o cliente MCP envia em "Authorization: Bearer <token>". Obrigatório. Gere um valor longo e aleatório.
MCP_TOKEN=

# Armazenamento das cenas. Com a integração Upstash da Vercel, KV_REST_API_URL/KV_REST_API_TOKEN já são criados.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Agente interno (ferramenta "agente") e modelo usado por ele.
ANTHROPIC_API_KEY=
AGENT_MODEL=claude-sonnet-5-5

# Busca na web: use um dos dois. Tavily tem prioridade se as duas existirem.
TAVILY_API_KEY=
BRAVE_API_KEY=

# Só para desenvolvimento local: caminho de um Chrome/Chromium instalado (o padrão é o Chromium da Vercel).
# CHROME_PATH=
